# --- added with the analysis and dataset-generation code ---
# Manuscript PDF and the reviewer correspondence. Not source, and the
# review email contains personal addresses.
/.docs/
# Stop new bytecode being committed. The .pyc files already tracked on main
# are unaffected; remove them separately if you want them gone.
__pycache__/
*.py[cod]
# Outputs of nn_proj.analysis; regenerate with aggregate.py / figures.py
/tables/
/plots/
/results/
/blast_eval/
# Trained checkpoints written by run_grid.py / the shell templates -- large
# binaries, regenerate by rerunning training. Was missing an entry here
# (unlike /results/ etc. above) until run_grid.py's train stage actually
# produced one for the first time; see docs/REVISION_PLAN.md.
/checkpoints/
# Generated datasets; regenerate with data_gen/. The species splits are tracked.
/data_gen/pbsim/csv_data/
/data_gen/pbsim/pbsim_raw/
/data_gen/pbsim/sequences/
# Generated datasets; regenerate with data_gen/promoter_motifs/. The split
# manifests (splits/motif_splits.csv, splits_v2/motif_splits.csv,
# splits_v3/motif_splits.csv) are tracked; the raw/annotated corpus and the
# sequence-bearing model-ready CSVs are not.
/data_gen/promoter_motifs/csv_data/
/data_gen/promoter_motifs/csv_data_v2/
/data_gen/promoter_motifs/csv_data_v3/
/data_gen/promoter_motifs/genomic_benchmarks/
/data_gen/promoter_motifs/motifs/
/data_gen/promoter_motifs/fimo_out/
/data_gen/promoter_motifs/promoters_all.csv
/data_gen/promoter_motifs/promoters_annotated.csv
/data_gen/promoter_motifs/promoters_all.fa
/data_gen/promoter_motifs/promoters_positive_train.fa
/data_gen/promoter_motifs/promoters_negative_train.fa
# Generated by data_gen/label_noise/make_noisy_labels.py; regenerate via that
# script (fixed NOISE_SEED, see its docstring). manifest.csv (sequence_id/
# label/original_label/noisy/split/noise_rate only, no sequence text) is
# tracked, same convention as promoter_motifs' split manifests above; the
# sequence-bearing per-rate train/test CSVs are not. pilot_metrics.csv is the
# small aggregated diagnostic summary and is tracked.
/data_gen/label_noise/csv_data_r00/
/data_gen/label_noise/csv_data_r05/
/data_gen/label_noise/csv_data_r10/
/data_gen/label_noise/csv_data_r20/
/data_gen/label_noise/csv_data_r40/
# Generated by data_gen/darkmatter/build_csv.py; regenerate from the raw
# *.fastq.gz reads (which are themselves untracked -- see build_csv.py's
# docstring for what's known/unknown about this dataset's provenance).
/data_gen/darkmatter/csv_data/
# Backups written by nn_proj.analysis.repair --write
*.csv.corrupt
.pytest_cache/
# Large raw data kept next to the code (tens of GB). Never commit these.
# Dark matter: CAMISIM reads (*.fastq.gz) and assemblies; only scripts are tracked.
/data_gen/darkmatter/*
!/data_gen/darkmatter/*.py
!/data_gen/darkmatter/*.sh
# PBSIM reference genomes (data_gen/pbsim/raw_sequences, also the input to
# data_gen/clean_fragments/build_fragments.py) and derived read windows.
/data_gen/pbsim/raw_sequences/
/data_gen/pbsim/truncation_control/
# Superseded experiments whose code lives only on the archive branches.
/data_gen/leave_phyla_out*/
/data_gen/gene_taxa/
/data_gen/uq_metrics_followup/
/data_gen/uq_sweep/results_prelabelmerge_backup/
/data_gen/promoter_motifs/splits_v2/
# Claude Code files: project instructions, local settings, agent worktrees
**/CLAUDE.md
**/CLAUDE.local.md
.claude/
.mcp.json
